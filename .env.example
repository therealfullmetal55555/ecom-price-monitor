# Telegram (for alerts) - get from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Wildberries scraping settings
WB_DEST=-1257786
WB_DELAY_SECONDS=1.5
WB_MAX_REQUESTS_PER_MINUTE=20

# Alert threshold (e.g. 0.05 = 5% cheaper than my price)
ALERT_THRESHOLD=0.05

# Scheduler
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
TIMEZONE=Europe/Tallinn

# Database
DB_PATH=data/price_history.db
